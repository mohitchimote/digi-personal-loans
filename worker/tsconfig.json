{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src", "scripts", "drizzle.config.ts"],
  "exclude": ["scripts/pdf-smoke-test.ts", "scripts/seed-reference.ts", "scripts/pdf-bilingual-spike.ts", "scripts/letter-render-spike.ts", "scripts/lib/iso-countries.ts", "scripts/seed-personal-details-options.ts"]
}
