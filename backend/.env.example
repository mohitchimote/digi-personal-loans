# Copy this file to .env (same directory as docker-compose.yml) before running
# `docker compose up`. .env is gitignored — never commit real values, even for local dev.

# Must be identical across every service — tokens are validated statelessly, with no shared
# session store (DigiLend_Production_Architecture.docx §6.1). Generate a real random value for
# anything beyond a laptop, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-bytes

# Shared MySQL root credentials for local/dev compose only — every service's
# createDatabaseIfNotExist=true JDBC URL relies on a user with CREATE DATABASE privilege, which is
# why this is root here. A real deployment uses a managed MySQL instance with per-service
# credentials from a secrets manager (PRODUCTION_READINESS.md §4), not this file's pattern.
MYSQL_ROOT_PASSWORD=root
DB_USERNAME=root
DB_PASSWORD=root

# Optional — notification-service degrades to a clear "not configured" error on email send if
# these are left blank, exactly like worker/src/lib/email.ts's deliverEmail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
