{
  "description": "Validating a letter template before it can be published. `expect` is every issue as severity:code, sorted; the same issue raised twice in one place counts once. See README, Validating.",
  "dictionary": "dictionary.sample.json",
  "vectors": [
    {
      "name": "a clean letter has no issues",
      "document": {
        "formatVersion": 1,
        "header": [],
        "body": [
          {
            "id": "p1",
            "t": "paragraph",
            "text": {
              "en": "Loan {{loan.amount}} over {{loan.termMonths}}",
              "he": "Loan {{loan.amount}} over {{loan.termMonths}}"
            }
          },
          {
            "id": "w1",
            "t": "when",
            "rule": {
              "t": "condition",
              "field": "loan.rateType",
              "op": "eq",
              "rhs": {
                "k": "value",
                "v": "VARIABLE"
              }
            },
            "children": [
              {
                "id": "p2",
                "t": "paragraph",
                "text": {
                  "en": "Variable",
                  "he": "Variable"
                }
              }
            ]
          },
          {
            "id": "r1",
            "t": "repeat",
            "over": "applicants",
            "where": {
              "t": "condition",
              "field": "item.role",
              "op": "eq",
              "rhs": {
                "k": "value",
                "v": "MAIN"
              }
            },
            "children": [
              {
                "id": "p3",
                "t": "paragraph",
                "text": {
                  "en": "{{item.fullName}}",
                  "he": "{{item.fullName}}"
                }
              }
            ]
          }
        ],
        "footer": []
      },
      "expect": []
    },
    {
